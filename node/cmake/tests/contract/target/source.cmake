function(rund_node_source_relative out source)
  get_property(node_root GLOBAL PROPERTY RUND_NODE_TEST_ROOT)
  if(IS_ABSOLUTE "${source}")
    set(path "${source}")
  else()
    set(path "${node_root}/${source}")
  endif()
  get_filename_component(path "${path}" ABSOLUTE)
  file(RELATIVE_PATH relative "${node_root}" "${path}")
  set(${out} "${relative}" PARENT_SCOPE)
endfunction()

function(rund_node_source_index out prefix)
  set(canonical)
  foreach(source IN LISTS ARGN)
    rund_node_source_relative(relative "${source}")
    list(APPEND canonical "${relative}")
    string(SHA256 source_key "${relative}")
    set(count_var "${prefix}_${source_key}")
    if(DEFINED ${count_var})
      math(EXPR count "${${count_var}} + 1")
    else()
      set(count 1)
    endif()
    set(${count_var} "${count}")
    set(${count_var} "${count}" PARENT_SCOPE)
  endforeach()
  set(${out} ${canonical} PARENT_SCOPE)
endfunction()

function(rund_node_source_occurrences out prefix owner)
  string(SHA256 source_key "${owner}")
  set(count_var "${prefix}_${source_key}")
  if(DEFINED ${count_var})
    set(count "${${count_var}}")
  else()
    set(count 0)
  endif()
  set(${out} "${count}" PARENT_SCOPE)
endfunction()
