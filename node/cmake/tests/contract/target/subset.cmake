function(rund_node_subset_sources out)
  if(NOT ARGN)
    message(FATAL_ERROR "Node test subset has no cases")
  endif()
  set(candidates)
  foreach(name IN LISTS ARGN)
    rund_node_case_owner(owner "${name}")
    rund_node_case_suite(suite "${name}")
    if(owner STREQUAL "" OR suite STREQUAL "")
      message(FATAL_ERROR "Unknown Node subset case: ${name}")
    endif()
    string(SHA256 suite_key "${suite}")
    get_property(suite_sources_set GLOBAL PROPERTY
      "RUND_NODE_SUITE_SOURCES_${suite_key}" SET)
    if(NOT suite_sources_set)
      message(FATAL_ERROR "Node subset suite has no source owner: ${suite}")
    endif()
    get_property(suite_sources GLOBAL PROPERTY
      "RUND_NODE_SUITE_SOURCES_${suite_key}")
    list(APPEND candidates ${suite_sources})
  endforeach()
  list(REMOVE_DUPLICATES candidates)

  set(selected)
  foreach(source IN LISTS candidates)
    rund_node_source_selected(
      include_source unused_relative unused_companions "${source}" ${ARGN})
    if(include_source)
      list(APPEND selected "${source}")
    endif()
  endforeach()

  set(owners)
  foreach(name IN LISTS ARGN)
    rund_node_case_owner(owner "${name}")
    list(APPEND owners "${owner}")
  endforeach()
  list(REMOVE_DUPLICATES owners)
  rund_node_source_index(
    unused_sources subset_source_count ${candidates})
  foreach(owner IN LISTS owners)
    rund_node_source_occurrences(
      owner_count subset_source_count "${owner}")
    if(NOT owner_count EQUAL 1)
      message(FATAL_ERROR
        "Node subset owner ${owner} occurs ${owner_count} times")
    endif()
  endforeach()
  set(${out} ${selected} PARENT_SCOPE)
endfunction()

function(rund_node_subset_case_file out target)
  if(NOT ARGN)
    message(FATAL_ERROR "Node test subset ${target} has no cases")
  endif()
  set(content)
  foreach(name IN LISTS ARGN)
    rund_node_case_symbol(symbol "${name}")
    if(symbol STREQUAL "")
      message(FATAL_ERROR "Unknown Node subset case: ${name}")
    endif()
    string(APPEND content
      "RUND_NODE_TEST_CASE(\"${name}\", ${symbol})\n")
  endforeach()
  set(subset_dir "${CMAKE_CURRENT_BINARY_DIR}/node-contract/subsets")
  file(MAKE_DIRECTORY "${subset_dir}")
  set(case_file "${subset_dir}/${target}.def")
  file(GENERATE OUTPUT "${case_file}" CONTENT "${content}")
  set(${out} "${case_file}" PARENT_SCOPE)
endfunction()
