function(rund_node_require_suite_owners suite source_index)
  list(LENGTH NODE_TEST_CASES case_count)
  math(EXPR last_case "${case_count} - 1")
  foreach(index RANGE 0 ${last_case})
    list(GET NODE_TEST_CASE_SUITES ${index} case_suite)
    if(NOT case_suite STREQUAL suite)
      continue()
    endif()
    list(GET NODE_TEST_CASES ${index} name)
    list(GET NODE_TEST_CASE_OWNERS ${index} owner)
    rund_node_source_occurrences(
      owner_count "${source_index}" "${owner}")
    if(NOT owner_count EQUAL 1)
      message(FATAL_ERROR
        "Node case ${name} owner ${owner} occurs ${owner_count} times in its source suite")
    endif()
  endforeach()
endfunction()

function(rund_node_select_suite_sources out suite)
  if(IS_ABSOLUTE "${suite}")
    get_filename_component(suite_path "${suite}" ABSOLUTE)
  else()
    get_filename_component(
      suite_path "${CMAKE_CURRENT_SOURCE_DIR}/tests/contract/${suite}" ABSOLUTE)
  endif()
  list(FIND NODE_TEST_CASE_SUITES "${suite_path}" suite_index)
  if(suite_index EQUAL -1)
    message(FATAL_ERROR "Unknown Node test source suite: ${suite}")
  endif()
  list(GET NODE_TEST_CASE_GROUPS ${suite_index} suite_group)
  get_property(mapped_suites GLOBAL PROPERTY RUND_NODE_SOURCE_PARTITION_SUITES)
  list(FIND mapped_suites "${suite_path}" duplicate_partition)
  if(NOT duplicate_partition EQUAL -1)
    message(FATAL_ERROR "Duplicate Node test source suite: ${suite}")
  endif()
  set_property(GLOBAL APPEND PROPERTY
    RUND_NODE_SOURCE_PARTITION_SUITES "${suite_path}")
  set_property(GLOBAL APPEND PROPERTY RUND_NODE_SOURCE_PARTITION_ROWS
    "${suite_group}|${suite_path}")
  string(SHA256 suite_key "${suite_path}")
  get_property(suite_sources_set GLOBAL PROPERTY
    "RUND_NODE_SUITE_SOURCES_${suite_key}" SET)
  if(suite_sources_set)
    message(FATAL_ERROR "Duplicate Node suite source owner: ${suite}")
  endif()
  set_property(GLOBAL PROPERTY "RUND_NODE_SUITE_SOURCES_${suite_key}" "${ARGN}")
  rund_node_source_index(
    canonical_sources suite_source_count ${ARGN})
  rund_node_require_suite_owners("${suite_path}" suite_source_count)
  foreach(source IN LISTS canonical_sources)
    rund_node_companion_cases(companions "${source}")
    foreach(name IN LISTS companions)
      rund_node_case_suite(companion_suite "${name}")
      if(NOT companion_suite STREQUAL suite_path)
        message(FATAL_ERROR
          "Node test companion ${source} belongs to ${companion_suite}, not ${suite_path}")
      endif()
    endforeach()
  endforeach()

  set(selected ${${out}})
  if(NOT RUND_NODE_FOCUSED_CASE)
    list(APPEND selected ${ARGN})
  else()
    foreach(focus IN LISTS RUND_NODE_FOCUSED_CASES)
      rund_node_case_suite(focus_suite "${focus}")
      if(focus_suite STREQUAL suite_path)
        list(APPEND selected ${ARGN})
        break()
      endif()
    endforeach()
  endif()
  set(${out} ${selected} PARENT_SCOPE)
endfunction()

function(rund_node_require_suite_partitions group)
  set(expected)
  list(LENGTH NODE_TEST_CASES case_count)
  math(EXPR last_case "${case_count} - 1")
  foreach(index RANGE 0 ${last_case})
    list(GET NODE_TEST_CASE_GROUPS ${index} case_group)
    if(case_group STREQUAL group)
      list(GET NODE_TEST_CASE_SUITES ${index} suite)
      list(APPEND expected "${suite}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES expected)
  list(SORT expected)

  get_property(rows GLOBAL PROPERTY RUND_NODE_SOURCE_PARTITION_ROWS)
  set(actual)
  foreach(row IN LISTS rows)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 row_group)
    if(row_group STREQUAL group)
      list(GET fields 1 suite)
      list(APPEND actual "${suite}")
    endif()
  endforeach()
  list(SORT actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR
      "Node test source suites for ${group} do not match its registry suites")
  endif()
endfunction()
