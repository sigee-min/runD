function(rund_node_companion_cases out source)
  string(SHA256 source_key "${source}")
  get_property(matches GLOBAL PROPERTY
    "RUND_NODE_COMPANION_CASES_${source_key}")
  set(${out} ${matches} PARENT_SCOPE)
endfunction()

function(rund_node_validate_companion_rows)
  set(sources)
  foreach(row IN LISTS RUND_NODE_TEST_COMPANION_ROWS)
    string(REPLACE "|" ";" fields "${row}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 2)
      message(FATAL_ERROR "Malformed Node test companion row: ${row}")
    endif()
    list(GET fields 0 source)
    list(GET fields 1 encoded_cases)
    if(NOT source MATCHES "^tests/contract/[A-Za-z0-9_./-]+[.]cpp$" OR
       encoded_cases STREQUAL "")
      message(FATAL_ERROR "Invalid Node test companion row: ${row}")
    endif()
    list(FIND sources "${source}" duplicate_source)
    if(NOT duplicate_source EQUAL -1)
      message(FATAL_ERROR "Duplicate Node test companion source: ${source}")
    endif()
    list(FIND rund_node_registered_test_sources "${source}" source_index)
    if(source_index EQUAL -1)
      message(FATAL_ERROR
        "Node test companion is not a registered source: ${source}")
    endif()
    list(FIND NODE_TEST_CASE_OWNERS "${source}" owner_index)
    if(NOT owner_index EQUAL -1)
      message(FATAL_ERROR
        "Node test companion duplicates a registered case owner: ${source}")
    endif()
    string(REPLACE "," ";" cases "${encoded_cases}")
    set(unique_cases ${cases})
    list(REMOVE_DUPLICATES unique_cases)
    list(LENGTH cases case_count)
    list(LENGTH unique_cases unique_count)
    if(case_count EQUAL 0 OR NOT case_count EQUAL unique_count)
      message(FATAL_ERROR
        "Node test companion has an empty or duplicate case list: ${row}")
    endif()
    foreach(name IN LISTS cases)
      list(FIND NODE_TEST_CASES "${name}" case_index)
      if(case_index EQUAL -1)
        message(FATAL_ERROR
          "Node test companion names an unknown case: ${name}")
      endif()
    endforeach()
    string(SHA256 source_key "${source}")
    set_property(GLOBAL PROPERTY
      "RUND_NODE_COMPANION_CASES_${source_key}" "${cases}")
    list(APPEND sources "${source}")
  endforeach()
endfunction()

function(rund_node_source_selected out relative_out companions_out source)
  rund_node_source_relative(relative "${source}")
  rund_node_companion_cases(companions "${relative}")
  set(${relative_out} "${relative}" PARENT_SCOPE)
  set(${companions_out} ${companions} PARENT_SCOPE)
  if(companions)
    foreach(name IN LISTS ARGN)
      list(FIND companions "${name}" selected_index)
      if(NOT selected_index EQUAL -1)
        set(${out} TRUE PARENT_SCOPE)
        return()
      endif()
    endforeach()
    set(${out} FALSE PARENT_SCOPE)
    return()
  endif()

  list(FIND NODE_TEST_CASE_OWNERS "${relative}" owner_index)
  if(owner_index EQUAL -1)
    set(${out} TRUE PARENT_SCOPE)
    return()
  endif()
  foreach(name IN LISTS ARGN)
    rund_node_case_owner(owner "${name}")
    if(relative STREQUAL owner)
      set(${out} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} FALSE PARENT_SCOPE)
endfunction()
