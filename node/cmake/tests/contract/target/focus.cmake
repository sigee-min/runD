function(rund_node_focused_sources out target)
  if(RUND_NODE_FOCUSED_CASE)
    rund_node_case_group(focus_group "${RUND_NODE_FOCUSED_CASE}")
    if(focus_group STREQUAL "")
      message(FATAL_ERROR
        "Unknown focused Node contract case: ${RUND_NODE_FOCUSED_CASE}")
    endif()
    rund_node_route(focus_target unused_resource "${focus_group}")
    if(NOT focus_target STREQUAL target)
      set(${out} "" PARENT_SCOPE)
      return()
    endif()
    set(target_cases ${RUND_NODE_FOCUSED_CASES})
  else()
    set(target_cases)
    list(LENGTH NODE_TEST_CASES case_count)
    math(EXPR last_case "${case_count} - 1")
    foreach(index RANGE 0 ${last_case})
      list(GET NODE_TEST_CASE_GROUPS ${index} case_group)
      rund_node_route(case_target unused_resource "${case_group}")
      if(case_target STREQUAL target)
        list(GET NODE_TEST_CASES ${index} name)
        list(APPEND target_cases "${name}")
      endif()
    endforeach()
  endif()
  rund_node_source_index(
    canonical_sources focus_source_count ${ARGN})
  foreach(name IN LISTS target_cases)
    rund_node_case_owner(owner "${name}")
    rund_node_source_occurrences(
      owner_count focus_source_count "${owner}")
    if(NOT owner_count EQUAL 1)
      message(FATAL_ERROR
        "Node case ${name} owner ${owner} occurs ${owner_count} times in target ${target}")
    endif()
  endforeach()

  if(NOT RUND_NODE_FOCUSED_CASE)
    set(${out} ${ARGN} PARENT_SCOPE)
    return()
  endif()

  set(focus_content)
  set(link_profile)
  foreach(name IN LISTS target_cases)
    rund_node_case_symbol(focus_symbol "${name}")
    rund_node_case_effective_link_profile(case_profile "${name}")
    if(link_profile AND NOT case_profile STREQUAL link_profile)
      message(FATAL_ERROR
        "Focused Node cases do not share one effective link profile")
    endif()
    set(link_profile "${case_profile}")
    string(APPEND focus_content
      "RUND_NODE_TEST_CASE(\"${name}\", ${focus_symbol})\n")
  endforeach()
  set(filtered)
  list(LENGTH canonical_sources source_count)
  if(source_count GREATER 0)
    math(EXPR last_source "${source_count} - 1")
    foreach(source_index RANGE 0 ${last_source})
      list(GET ARGN ${source_index} source)
      list(GET canonical_sources ${source_index} canonical)
      rund_node_source_selected(
        selected relative companions "${canonical}" ${target_cases})
      list(FIND NODE_TEST_CASE_OWNERS "${relative}" owner_index)
      if(selected AND
         (NOT link_profile STREQUAL "header" OR companions OR
          NOT owner_index EQUAL -1))
        list(APPEND filtered "${source}")
      endif()
    endforeach()
  endif()

  set(focus_dir "${CMAKE_CURRENT_BINARY_DIR}/focused-node-contract")
  file(MAKE_DIRECTORY "${focus_dir}")
  set(focus_cases "${focus_dir}/${target}.def")
  file(GENERATE OUTPUT "${focus_cases}" CONTENT "${focus_content}")
  set_property(GLOBAL PROPERTY RUND_NODE_FOCUSED_CASE_FILE "${focus_cases}")
  set(${out} ${filtered} PARENT_SCOPE)
endfunction()
