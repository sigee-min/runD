function(rund_node_require_target_scc target expected)
  if(NOT TARGET ${target})
    return()
  endif()
  get_target_property(actual ${target} RUND_NODE_REQUIRED_SCC_ROOT)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR
      "Node test target ${target} requires ${actual}, expected ${expected}")
  endif()
  rund_node_scc_link_target(expected_target "${expected}")
  if(NOT expected_target)
    set(expected_target "-")
  endif()
  get_target_property(actual_target ${target} RUND_NODE_REQUIRED_SCC_TARGET)
  if(NOT actual_target STREQUAL expected_target)
    message(FATAL_ERROR
      "Node test target ${target} links ${actual_target}, expected ${expected_target}")
  endif()
  if(NOT expected_target STREQUAL "-")
    get_target_property(link_libraries ${target} LINK_LIBRARIES)
    list(FIND link_libraries "${expected_target}" expected_link_index)
    if(expected_link_index EQUAL -1)
      message(FATAL_ERROR
        "Node test target ${target} does not link ${expected_target}")
    endif()
  endif()
endfunction()
