#!/bin/sh
set -eu

usage() {
  printf '%s\n' \
    "Measure typed Flow construction and installed-header frontend cost." \
    "usage: tools/measure/flow/run" \
    "       -h, --help  Show this help."
}

if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  usage
  exit 0
fi
if [ "$#" -ne 0 ]; then
  usage >&2
  exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
release=$(sh "$root/tools/internal/state/root" "$root" release)
prefix="$release/runD-install"
build=$(sh "$root/tools/internal/state/root" "$root" measure/flow)

if ! sh "$root/tools/internal/state/lock" --held "$root" "$release"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$release" \
    "$0" "$@"
fi
if ! sh "$root/tools/internal/state/lock" --held "$root" "$build"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$build" \
    "$0" "$@"
fi
sh "$root/tools/internal/measure/attempt" "$root" measure-flow start
attempt_failed() {
  code=$?
  trap - EXIT HUP INT TERM
  [ "$code" -ne 0 ] || code=1
  sh "$root/tools/internal/measure/attempt" \
    "$root" measure-flow fail "$code" || :
  exit "$code"
}
trap attempt_failed EXIT HUP INT TERM
sh "$root/tools/internal/measure/prepare" "$root" "$build" \
  "$root/tools/measure/flow"

samples="$build/samples.tsv"
compiler=$(perl "$root/tools/internal/measure/compiler" "$build")
python3 "$root/tools/measure/flow/frontend.py" \
  "$compiler" "$prefix/include" \
  "$root/tools/measure/flow/minimal.cpp" \
  "$root/tools/measure/flow/typed.cpp" "$samples"
if sh "$root/tools/internal/process/run" 60 flow.measure "$build/runD-flow-measure" \
    >>"$samples" 2>&1; then
  status=passed
else
  code=$?
  status=failed
fi
cat "$samples"
sh "$root/tools/internal/measure/finish" "$root" "$build" \
  measure-flow "$status" "$samples" samples.tsv "${code:-0}"
sh "$root/tools/internal/measure/attempt" "$root" measure-flow complete
trap - EXIT HUP INT TERM
