#!/bin/sh
set -eu

usage() {
  printf '%s\n' \
    "Measure Program caching, coalescing, storage, and bounded execution." \
    "usage: tools/measure/graph/services/run" \
    "       -h, --help  Show this help."
}

if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  usage
  exit 0
fi
if [ "$#" -ne 0 ]; then
  usage >&2
  exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
build=$(sh "$root/tools/internal/state/root" "$root" measure/graph/services)

release=$(sh "$root/tools/internal/state/root" "$root" release)
if ! sh "$root/tools/internal/state/lock" --held "$root" "$release"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$release" \
    "$0" "$@"
fi
if ! sh "$root/tools/internal/state/lock" --held "$root" "$build"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$build" \
    "$0" "$@"
fi
sh "$root/tools/internal/measure/attempt" \
  "$root" measure-graph-services start
attempt_failed() {
  code=$?
  trap - EXIT HUP INT TERM
  [ "$code" -ne 0 ] || code=1
  sh "$root/tools/internal/measure/attempt" \
    "$root" measure-graph-services fail "$code" || :
  exit "$code"
}
trap attempt_failed EXIT HUP INT TERM
sh "$root/tools/internal/measure/prepare" "$root" "$build" \
  "$root/tools/measure/graph/services"

log="$build/measure.tsv"
if sh "$root/tools/internal/process/run" 900 graph-services.measure \
    "$build/runD-graph-services-measure" >"$log" 2>&1; then
  status=passed
else
  code=$?
  status=failed
fi
cat "$log"
sh "$root/tools/internal/measure/finish" "$root" "$build" \
  measure-graph-services "$status" "$log" measure.tsv "${code:-0}"
sh "$root/tools/internal/measure/attempt" \
  "$root" measure-graph-services complete
trap - EXIT HUP INT TERM
