#!/bin/sh
set -eu

usage() {
  printf '%s\n' \
    "Measure installed Product chains or one current-source diagnostic." \
    "usage: tools/measure/compute/run" \
    "       tools/measure/compute/run --resident <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --collective <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --sort <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --bulk <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --batch <metal|vulkan>" \
    "       tools/measure/compute/run --pipeline <metal|vulkan>" \
    "       tools/measure/compute/run --checkpoint <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --pipeline-profile <metal|vulkan>" \
    "       tools/measure/compute/run --recurrence <metal|vulkan>" \
    "       tools/measure/compute/run --window-repeat <metal|vulkan>" \
    "       tools/measure/compute/run --plan-memory <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --prepare-memory <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --virtual-residency <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --virtual-residency-resident <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --virtual-graph-residency <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --virtual-graph-pointwise <cpu|metal|vulkan>" \
    "       tools/measure/compute/run --virtual-route-matrix <metal|vulkan> [--profile <core|full>]" \
    "       tools/measure/compute/run --virtual-crossover" \
    "       tools/measure/compute/run --virtual-window" \
    "       tools/measure/compute/run --metal-icb-boundary" \
    "       -h, --help  Show this help."
}

if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  usage
  exit 0
fi
mode=full
backend=
route_matrix_profile=full
if [ "$#" -eq 2 ] && [ "$1" = "--virtual-route-matrix" ]; then
  case "$2" in
    metal|vulkan)
      mode=virtual-route-matrix
      backend=$2
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
elif [ "$#" -eq 4 ] && [ "$1" = "--virtual-route-matrix" ] &&
  [ "$3" = "--profile" ]; then
  case "$2" in
    metal|vulkan)
      case "$4" in
        core|full)
          mode=virtual-route-matrix
          backend=$2
          route_matrix_profile=$4
          ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
elif [ "$#" -eq 1 ] && [ "$1" = "--metal-icb-boundary" ]; then
  mode=metal-icb-boundary
  backend=metal
elif [ "$#" -eq 1 ] && [ "$1" = "--virtual-crossover" ]; then
  mode=virtual-crossover
  backend=metal
elif [ "$#" -eq 1 ] && [ "$1" = "--virtual-window" ]; then
  mode=virtual-window
  backend=metal
elif [ "$#" -eq 2 ] && { [ "$1" = "--resident" ] ||
  [ "$1" = "--collective" ] ||
  [ "$1" = "--sort" ] || [ "$1" = "--bulk" ] ||
  [ "$1" = "--batch" ] ||
  [ "$1" = "--pipeline" ] ||
  [ "$1" = "--checkpoint" ] ||
  [ "$1" = "--pipeline-profile" ] ||
  [ "$1" = "--recurrence" ] ||
  [ "$1" = "--window-repeat" ] ||
  [ "$1" = "--plan-memory" ] ||
  [ "$1" = "--prepare-memory" ] ||
  [ "$1" = "--virtual-residency" ] ||
  [ "$1" = "--virtual-residency-resident" ] ||
  [ "$1" = "--virtual-graph-residency" ] ||
  [ "$1" = "--virtual-graph-pointwise" ]; }; then
  case "$2" in
    cpu|metal|vulkan)
      mode=${1#--}
      backend=$2
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  if { [ "$mode" = pipeline ] || [ "$mode" = pipeline-profile ] ||
    [ "$mode" = recurrence ] || [ "$mode" = window-repeat ] ||
    [ "$mode" = batch ]; } &&
    [ "$backend" = cpu ]; then
    usage >&2
    exit 2
  fi
elif [ "$#" -ne 0 ]; then
  usage >&2
  exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
build=$(sh "$root/tools/internal/state/root" "$root" measure/compute)

if [ "$mode" != full ]; then
  focus="$build/focus"
  if ! sh "$root/tools/internal/state/lock" --held "$root" "$focus"; then
    exec sh "$root/tools/internal/state/lock" "$root" "$focus" \
      "$0" "$@"
  fi
  if { [ "$mode" = metal-icb-boundary ] ||
    [ "$mode" = virtual-crossover ] ||
    [ "$mode" = virtual-window ]; } && [ "$(uname -s)" != Darwin ]; then
    printf '%s\n' "--$mode requires native Apple Metal." >&2
    exit 1
  fi
  if [ "$mode" = virtual-route-matrix ]; then
    sh "$root/tools/internal/configure/contracts" \
      "$root" "$focus" local Release compute.pipeline \
      -DRUND_NODE_TEST_TAG:STRING= \
      -DRUND_NODE_FOCUSED_BACKEND:STRING="$backend" >&2
    sh "$root/tools/internal/state/ninja" -C "$focus" \
      runD-compute-route-matrix >&2
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      --aggregate "$focus/tools/measure/compute/runD-compute-route-matrix" \
      --aggregate \
      sh "$root/tools/internal/process/run" 900 \
      compute.virtual-route-matrix \
      "$focus/tools/measure/compute/runD-compute-route-matrix" \
      "$backend" "$route_matrix_profile"
  fi
  sh "$root/tools/internal/configure/contracts" \
    "$root" "$focus" local Release compute.pipeline \
    -DRUND_NODE_TEST_TAG:STRING= \
    -DRUND_NODE_FOCUSED_BACKEND:STRING="$backend"
  if [ "$mode" = metal-icb-boundary ]; then
    sh "$root/tools/internal/state/ninja" -C "$focus" \
      runD-metal-icb-boundary
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/process/run" 900 \
      compute.metal-icb-boundary \
      "$focus/tools/measure/compute/runD-metal-icb-boundary"
  fi
  sh "$root/tools/internal/state/ninja" -C "$focus" \
    runD-compute-focus
  if [ "$mode" = virtual-graph-residency ]; then
    if [ "$backend" = cpu ]; then
      exec sh "$root/tools/internal/measure/packets" \
        sh "$root/tools/internal/process/run" 900 \
        compute.virtual-graph-residency \
        "$focus/tools/measure/compute/runD-compute-focus" \
        --virtual-graph-residency "$backend"
    fi
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      sh "$root/tools/internal/process/run" 900 \
      compute.virtual-graph-residency \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-graph-residency "$backend"
  fi
  if [ "$mode" = virtual-graph-pointwise ]; then
    if [ "$backend" = cpu ]; then
      exec sh "$root/tools/internal/measure/packets" \
        sh "$root/tools/internal/process/run" 900 \
        compute.virtual-graph-pointwise \
        "$focus/tools/measure/compute/runD-compute-focus" \
        --virtual-graph-pointwise "$backend"
    fi
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      sh "$root/tools/internal/process/run" 900 \
      compute.virtual-graph-pointwise \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-graph-pointwise "$backend"
  fi
  if { [ "$mode" = virtual-residency ] ||
    [ "$mode" = virtual-residency-resident ]; }; then
    if [ "$backend" = cpu ]; then
      exec sh "$root/tools/internal/measure/packets" \
        sh "$root/tools/internal/process/run" 900 compute.virtual-residency \
        "$focus/tools/measure/compute/runD-compute-focus" \
        --"$mode" "$backend"
    fi
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      sh "$root/tools/internal/process/run" 900 compute.virtual-residency \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --"$mode" "$backend"
  fi
  if [ "$mode" = virtual-crossover ]; then
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      --aggregate "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-crossover-aggregate \
      sh "$root/tools/internal/process/run" 900 compute.virtual-crossover \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-crossover
  fi
  if [ "$mode" = virtual-window ]; then
    exec sh "$root/tools/internal/lock/accel" \
      sh "$root/tools/internal/measure/packets" \
      --aggregate "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-window-aggregate \
      sh "$root/tools/internal/process/run" 900 compute.virtual-window \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --virtual-window
  fi
  if [ "$backend" = cpu ]; then
    exec sh "$root/tools/internal/process/run" 900 \
      compute.measure \
      "$focus/tools/measure/compute/runD-compute-focus" \
      --"$mode" "$backend"
  fi
  exec sh "$root/tools/internal/lock/accel" \
    sh "$root/tools/internal/process/run" 900 \
    compute.measure \
    "$focus/tools/measure/compute/runD-compute-focus" \
    --"$mode" "$backend"
fi

release=$(sh "$root/tools/internal/state/root" "$root" release)
if ! sh "$root/tools/internal/state/lock" --held "$root" "$release"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$release" \
    "$0" "$@"
fi
if ! sh "$root/tools/internal/state/lock" --held "$root" "$build"; then
  exec sh "$root/tools/internal/state/lock" "$root" "$build" \
    "$0" "$@"
fi

sh "$root/tools/internal/measure/attempt" "$root" measure-compute start
attempt_failed() {
  code=$?
  trap - EXIT HUP INT TERM
  [ "$code" -ne 0 ] || code=1
  sh "$root/tools/internal/measure/attempt" \
    "$root" measure-compute fail "$code" || :
  exit "$code"
}
trap attempt_failed EXIT HUP INT TERM
sh "$root/tools/internal/measure/prepare" "$root" "$build" \
  "$root/tools/measure/compute"
log="$build/measure.log"
if sh "$root/tools/internal/lock/accel" \
    sh "$root/tools/internal/process/run" 900 \
    compute.measure "$build/runD-compute-measure" >"$log" 2>&1; then
  status=passed
else
  code=$?
  status=failed
fi
cat "$log"
sh "$root/tools/internal/measure/finish" "$root" "$build" \
  measure-compute "$status" "$log" measure.log "${code:-0}"
sh "$root/tools/internal/measure/attempt" "$root" measure-compute complete
trap - EXIT HUP INT TERM
