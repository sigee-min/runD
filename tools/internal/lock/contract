  "lock contract: same=75 wait=pass different=pass stale=75 same-nested=pass wait-nested=pass different-nested=pass release-measure=pass child75=75 descendant=invalid stale-reacquire=pass build=serialized state-ninja=same restat=serialized recompact=serialized different=closed unowned=closed forged=closed deps=valid backend-required=closed capacity=closed setup-failure=clean"
