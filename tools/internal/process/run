#!/bin/sh
set -eu

if [ "$#" -lt 3 ]; then
  echo "usage: tools/internal/process/run <seconds> <name> <command> [args...]" >&2
  exit 2
fi

timeout=$1
name=$2
shift 2

case "$timeout" in
  '' | *[!0-9]*)
    echo "bounded run requires a positive integer timeout" >&2
    exit 2
    ;;
esac
if [ "$timeout" -eq 0 ]; then
  echo "bounded run requires a positive integer timeout" >&2
  exit 2
fi
if ! command -v perl >/dev/null 2>&1; then
  echo "bounded run requires perl" >&2
  exit 2
fi

if perl -e 'alarm shift; exec @ARGV; die "exec failed: $!\n"' \
    "$timeout" "$@"; then
  exit 0
else
  code=$?
  if [ "$code" -eq 142 ]; then
    echo "$name exceeded $timeout seconds" >&2
  fi
  exit "$code"
fi
