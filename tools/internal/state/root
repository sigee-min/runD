#!/bin/sh
set -eu

mode=lookup
if [ "${1:-}" = --identify ]; then
  mode=identify
  shift
fi
if [ "$#" -ne 2 ]; then
  echo "usage: tools/internal/state/root [--identify] <root> <identity-or-build>" >&2
  exit 2
fi

root=$1
value=$2
if [ ! -d "$root" ]; then
  echo "build root is unavailable: $root" >&2
  exit 2
fi
root=$(CDPATH= cd -- "$root" && pwd -P)
registry="$root/tools/internal/state/roots.tsv"
if ! awk -F '\t' '
  NF != 3 { exit 2 }
  $1 !~ /^[a-z0-9][a-z0-9\/-]*$/ { exit 3 }
  $2 !~ /^\.cache\/[a-z0-9][a-z0-9\/-]*$/ ||
      $2 ~ /(^|\/)\.\.?(\/|$)/ || $2 ~ /\/\// { exit 4 }
  $3 !~ /^[a-z0-9][a-z0-9-]*$/ { exit 5 }
  identity[$1]++ || path[$2]++ || lock[$3]++ { exit 6 }
' "$registry"; then
  echo "static build-root registry is malformed: $registry" >&2
  exit 2
fi

case "$mode" in
  lookup)
    case "$value" in
      '' | *[!a-z0-9/-]* | [!a-z0-9]*) exit 2 ;;
    esac
    relative=$(awk -F '\t' -v identity="$value" \
      '$1 == identity { print $2 }' "$registry")
    if [ -z "$relative" ]; then
      echo "unknown static build identity: $value" >&2
      exit 2
    fi
    printf '%s/%s\n' "$root" "$relative"
    ;;
  identify)
    build=$value
    if [ -d "$build" ]; then
      build=$(CDPATH= cd -- "$build" && pwd -P)
    else
      case "$build" in
        /*) ;;
        *) exit 2 ;;
      esac
      case "$build" in
        *//* | */./* | */../* | */. | */..) exit 2 ;;
      esac
      build=${build%/}
    fi
    found=
    tab=$(printf '\t')
    while IFS="$tab" read -r identity relative lock; do
      path="$root/$relative"
      case "$build" in
        "$path" | "$path"/*)
          if [ -n "$found" ]; then
            echo "ambiguous static build root: $build" >&2
            exit 2
          fi
          found=$(printf '%s\t%s\t%s' "$identity" "$path" "$lock")
          ;;
      esac
    done <"$registry"
    if [ -z "$found" ]; then
      echo "unowned mutable build tree: $build" >&2
      exit 2
    fi
    printf '%s\n' "$found"
    ;;
esac
