      "$fixture" "$route" "$input" \
      >"$work/$name.out" 2>"$work/$name.err"; then
    echo "performance comparator accepted invalid $name input" >&2
    exit 1
  fi
  grep -q "$expected" "$work/$name.err"
}

reject_baseline_unit() {
  name=$1
  route=$2
  input=$3
  metric=$4
  observed=$5
  cp "$baseline" "$work/$name-baseline.tsv"
  awk -F '\t' -v OFS='\t' -v route="$route" -v metric="$metric" '
    $1 == "fixture" && $2 == route && $3 == metric {
      $7 = "bananas"; changed += 1
    }
    { print }
    END { if (changed != 1) exit 1 }
  ' "$work/$name-baseline.tsv" >"$baseline"
  reject "$name" "$route" "$input" \
    "$metric unit expected=bananas observed=$observed"
  mv "$work/$name-baseline.tsv" "$baseline"
}

