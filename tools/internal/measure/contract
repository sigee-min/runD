reject telemetry-growth measure-telemetry "$work/telemetry-growth.tsv" \
  'warm telemetry storage grew: record/1'

perl -F'\t' -lane \
  'if ($F[0] eq "sample" && $F[1] eq "live" && $F[2] eq "cold" && $F[3] == 1 && $F[4] eq "basic") { $F[10] = 1 } print join "\t", @F' \
  "$telemetry" >"$work/telemetry-phase.tsv"
reject telemetry-phase measure-telemetry "$work/telemetry-phase.tsv" \
  'non-Detail telemetry phase was measured: live/cold/1/basic'

perl -F'\t' -lane \
  'if ($F[0] eq "sample" && $F[1] eq "live" && $F[2] eq "cold" && $F[3] == 1 && $F[4] eq "disabled") { $F[7] = "18446744073709551616" } print join "\t", @F' \
  "$telemetry" >"$work/telemetry-overflow.tsv"
reject telemetry-overflow measure-telemetry "$work/telemetry-overflow.tsv" \
  'telemetry live/cold/1/disabled time:wall:ns exceeds uint64'

cp "$telemetry" "$work/telemetry-reference.tsv"
perl -0pi -e \
  's/reference\tlive\tcold\t1\twall\tbasic\t10/reference\tlive\tcold\t1\twall\tdisabled\t10/' \
  "$work/telemetry-reference.tsv"
reject telemetry-reference measure-telemetry "$work/telemetry-reference.tsv" \
  'telemetry reference delta mismatch: live/cold/1/wall'

cp "$telemetry" "$work/telemetry-identity.tsv"
perl -0pi -e \
  's/identity\tartifact\tsha256\tb/identity\tartifact\tsha256\tB/' \
  "$work/telemetry-identity.tsv"
reject telemetry-identity measure-telemetry "$work/telemetry-identity.tsv" \
