#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: tools/internal/measure/contract <root> <work>" >&2
  exit 2
fi

root=$1
work=$2
fixture="$work/root"
rm -rf "$work"
mkdir -p "$fixture/docs/reference/performance"
product_entry="$root/tools/measure/compute/suite/product.cpp"
product_owners="$root/tools/measure/compute/suite/product"

packet_probe="$work/packet-probe"
printf '%s\n' '#!/bin/sh' 'printf "probe,%s\n" "$RUND_MEASURE_PACKET"' \
  >"$packet_probe"
chmod +x "$packet_probe"
sh "$root/tools/internal/measure/packets" "$packet_probe" \
  >"$work/packet-probe.log"
[ "$(grep -c '^diagnostic_packet,begin,[123],3$' \
  "$work/packet-probe.log")" -eq 3 ]
[ "$(grep -c '^diagnostic_packet,end,[123],3$' \
  "$work/packet-probe.log")" -eq 3 ]
[ "$(grep -c '^probe,[123]$' "$work/packet-probe.log")" -eq 3 ]
test "$(sed -n '1p' "$work/packet-probe.log")" = \
  'diagnostic_packet,begin,1,3'
test "$(sed -n '9p' "$work/packet-probe.log")" = \
  'diagnostic_packet,end,3,3'
printf '%s\n' '#!/bin/sh' \
  '[ "$RUND_MEASURE_PACKET" -ne 2 ] || exit 7' \
  'printf "probe,%s\n" "$RUND_MEASURE_PACKET"' >"$packet_probe"
if sh "$root/tools/internal/measure/packets" "$packet_probe" \
    >"$work/packet-failure.log" 2>&1; then
  echo "diagnostic packet runner retried a failed packet" >&2
  exit 1
fi
[ "$(grep -c '^diagnostic_packet,begin,' "$work/packet-failure.log")" -eq 2 ]
[ "$(grep -c '^diagnostic_packet,end,' "$work/packet-failure.log")" -eq 1 ]

virtual_measure="$root/tools/measure/compute/virtual/residency.cpp"
virtual_oracle="$root/tools/measure/compute/virtual/oracle.cpp"
virtual_report="$root/tools/measure/compute/virtual/report.cpp"
virtual_registry="$root/tools/measure/compute/CMakeLists.txt"
rg -q '#include <rund/compute/virtual.hpp>' "$virtual_measure"
test "$(rg -o 'prepared->run\(\)' "$virtual_measure" | wc -l | tr -d ' ')" \
  -eq 1
test "$(rg -o 'prepared->run\(active_count\)' "$virtual_measure" | wc -l | tr -d ' ')" \
  -eq 2
test "$(rg -o 'prepared->profile\(\)' "$virtual_measure" | wc -l | tr -d ' ')" \
  -eq 3
rg -q 'WarmSamples = 60u' \
  "$root/tools/measure/compute/virtual/model.hpp"
rg -q 'ActiveCounts' \
  "$root/tools/measure/compute/virtual/model.hpp"
rg -q 'LogicalElements > FrameElements' \
  "$root/tools/measure/compute/virtual/model.hpp"
rg -Fq 'samples_allocation_free(sampled_runs)' "$virtual_oracle"
rg -Fq 'sampled_runs == 0u ||' "$virtual_oracle"
rg -Fq 'rund_allocation_free_runs' "$virtual_report"
rg -Fq 'process_global_allocation_status' "$virtual_report"
rg -Fq 'return "not_measured"' "$virtual_report"
rg -Fq 'prepare_pipeline_compiles' "$virtual_report"
rg -Fq 'terminal_pipeline_compiles' "$virtual_report"
test "$(rg -o 'prepared->stats\(\)' "$virtual_measure" | wc -l | tr -d ' ')" \
  -eq 0
rg -Fq 'preparation_stats.pipeline.preparation_evidence' "$virtual_report"
for virtual_source in backing.cpp model.cpp oracle.cpp report.cpp residency.cpp; do
  rg -Fq "virtual/$virtual_source" "$virtual_registry"
done
rg -q -- '--virtual-residency <cpu|metal|vulkan>' \
  "$root/tools/measure/compute/run"

if rg -n 'NonnegativeDelta|constexpr std::uint64_t delta' \
    "$root/tools/measure/compute/process.hpp" \
    "$product_entry" "$product_owners" >/dev/null; then
  echo "Compute measurement owns a parallel counter delta" >&2
  exit 1
fi
rg -q 'counter::Delta' "$root/tools/measure/compute/process.hpp"
if rg -n 'pipeline_result->(stats|memory)\(' \
    "$product_entry" "$product_owners" >/dev/null; then
  echo "Product measurement bypasses Profile" >&2
  exit 1
fi
if rg -n 'write_stats\(' \
    "$product_entry" "$product_owners" >/dev/null; then
  echo "Product measurement bypasses Profile for host-write evidence" >&2
  exit 1
fi
test "$(rg -o '\.profile\(' "$product_entry" "$product_owners" |
  wc -l | tr -d ' ')" -eq 1
rg -q 'auto observed = pipeline\.profile\(\);' \
  "$product_entry" "$product_owners"
test "$(rg -o 'pipeline_result->begin_samples\(\)' \
  "$product_entry" "$product_owners" | wc -l | tr -d ' ')" -eq 2
test "$(rg -o 'pipeline_result->end_samples\(\)' \
  "$product_entry" "$product_owners" | wc -l | tr -d ' ')" -eq 2
test "$(rg -o 'pipeline\.samples_clean\(WarmSamples\)' \
  "$product_entry" "$product_owners" | wc -l | tr -d ' ')" -eq 2

route_metrics() {
  perl - "$root" "$1" <<'PERL'
use strict;
use warnings;
my ($root, $route) = @ARGV;
require "$root/tools/internal/measure/schema.pm";
print RundMeasureSchema::route($route)->{metrics};
PERL
}

compute_metrics=$(route_metrics measure-compute)
telemetry_metrics=$(route_metrics measure-telemetry)
[ "$compute_metrics" -eq 82 ] || {
  echo "Compute route cardinality changed: $compute_metrics" >&2
  exit 1
}
darwin_rows=$(perl - "$root" <<'PERL'
use strict;
use warnings;
my ($root) = @ARGV;
require "$root/tools/internal/measure/schema.pm";
print RundMeasureSchema::data_rows('Darwin');
PERL
)
[ "$darwin_rows" -eq 262 ] || {
  echo "Darwin baseline cardinality changed: $darwin_rows" >&2
  exit 1
}
system=$(uname -s)
release=$(uname -r)
machine=$(uname -m)
workers=$(getconf _NPROCESSORS_ONLN)
model=-
cpu=-
if [ "$system" = Darwin ]; then
  model=$(sysctl -n hw.model)
  cpu=$(sysctl -n machdep.cpu.brand_string)
fi

manifest_file="$work/source-manifest.tsv"
printf '%s\n' 'fixture-source-manifest' >"$manifest_file"
manifest_digest=$(cmake -E sha256sum "$manifest_file" | awk '{ print $1 }')

flow="$work/flow.tsv"
printf '%s\n' \
  'metric	sample	unit	value' \
  'alpha	median	ms	10.000' \
  'beta	median	ms	10.000' \
  'graph	1	us	9.000' \
  'graph	2	us	11.000' \
  'graph	median	us	10.000' \
  'omega	median	us	10.000' >"$flow"

compute_observation="$work/compute-observation.csv"
printf '%s\n' \
  'product_cold_columns,backend,chain,shape,status,capacity,active_count,radius,window_size,stride,candidate,width,stages,shared_capacity,candidate_scratch_bytes,source_hi,source_lo,execution_hi,execution_lo,first_result_us,author_us,compile_us,upload_us,prepare_us,run_us,read_us,dispatches,run_submissions,terminal_submissions,terminal_readbacks,logical_upload_bytes,logical_readback_bytes,downloaded_bytes,peak_retained_bytes,resident_peak_bytes,scratch_payload_bytes,scratch_backing_bytes,pipeline_compiles,pipeline_cache_hits,prepared_templates,graph_hash,output_hash,result' \
  'product_warm_columns,backend,chain,shape,status,capacity,active_count,radius,window_size,stride,candidate,width,stages,shared_capacity,candidate_scratch_bytes,source_hi,source_lo,execution_hi,execution_lo,samples,warm_p50_us,warm_p95_us,active_elements_per_s,dispatches_per_run,submissions_per_run,terminal_submissions,terminal_readbacks,downloaded_bytes,peak_retained_bytes,resident_peak_bytes,scratch_payload_bytes,scratch_backing_bytes,sampled_runs,clean_runs,warm_cache_hits,graph_hash,output_hash,result' \
  >"$compute_observation"

emit_product_cold() {
  product_backend=$1
  product_run_submits=$2
  product_terminal_submits=$3
  product_chain=$4
  product_shape=$5
  product_capacity=$6
  product_active=$7
  product_radius=$8
  product_window=$9
  shift 9
  product_stride=$1
  printf 'product_cold,%s,%s,%s,ok,%s,%s,%s,%s,%s,prefix,64,4,0,1024,1,2,3,4,10.000,1.000,2.000,1.000,2.000,3.000,1.000,4,%s,%s,1,4096,4,4,8192,8192,1024,1024,1,0,4,11,12,7\n' \
    "$product_backend" "$product_chain" "$product_shape" \
    "$product_capacity" "$product_active" "$product_radius" \
    "$product_window" "$product_stride" "$product_run_submits" \
    "$product_terminal_submits" >>"$compute_observation"
}

emit_product_warm() {
  product_backend=$1
  product_run_submits=$2
  product_terminal_submits=$3
  product_chain=$4
  product_shape=$5
  product_capacity=$6
  product_active=$7
  product_radius=$8
  product_window=$9
  shift 9
  product_stride=$1
  printf 'product_warm,%s,%s,%s,ok,%s,%s,%s,%s,%s,prefix,64,4,0,1024,1,2,3,4,60,10.000,10.000,1000000.000,4,%s,%s,1,4,8192,8192,1024,1024,60,60,0,11,12,7\n' \
    "$product_backend" "$product_chain" "$product_shape" \
    "$product_capacity" "$product_active" "$product_radius" \
    "$product_window" "$product_stride" "$product_run_submits" \
    "$product_terminal_submits" >>"$compute_observation"
}

for product_backend in cpu metal vulkan; do
  product_run_submits=1
  [ "$product_backend" = cpu ] && product_run_submits=0
  product_terminal_submits=0
  [ "$product_backend" = vulkan ] && product_terminal_submits=1
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" window n4096_r4 4096 4096 4 9 1
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" window n4096_r1024 4096 4096 1024 2049 1
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" window n262144_r4 262144 262144 4 9 1
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" window n262144_r1024 262144 262144 1024 2049 1
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" pool n4096_k129_s2 4096 4096 0 129 2
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" pool n262144_k2049_s2 262144 262144 0 2049 2
  emit_product_cold "$product_backend" "$product_run_submits" "$product_terminal_submits" rolling m262144_r1024_n0 262144 0 1024 2049 1

  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" window n4096_r4 4096 4096 4 9 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" window n4096_r1024 4096 4096 1024 2049 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" window n262144_r4 262144 262144 4 9 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" window n262144_r1024 262144 262144 1024 2049 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" pool n4096_k129_s2 4096 4096 0 129 2
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" pool n262144_k2049_s2 262144 262144 0 2049 2
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" rolling m262144_r1024_n0 262144 0 1024 2049 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" rolling m262144_r1024_n257 262144 257 1024 2049 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" rolling m262144_r1024_n131072 262144 131072 1024 2049 1
  emit_product_warm "$product_backend" "$product_run_submits" "$product_terminal_submits" rolling m262144_r1024_n262144 262144 262144 1024 2049 1
done

scheduler_observation="$work/scheduler-observation.log"
printf '%s\n' \
  'spawn_complete ok=1 reason=ok ops=1 cold_ns_per_op=10 warm_median_ns_per_op=9' \
  >"$scheduler_observation"
index=1
while [ "$index" -le 46 ]; do
  printf 'task_scale task_scale_workers=1 ops=%u payload_ops=0 cold_ns_per_op=10 warm_median_ns_per_op=10\n' \
    "$index" >>"$scheduler_observation"
  index=$((index + 1))
done

graph_observation="$work/graph-observation.tsv"
printf '%s\n' \
  'async_same_key	32	us	10.000	cache_misses	1	waits	1	hits	30' \
  'beta	1	us	10.000' \
  'delta	1	us	10.000' \
  'epsilon	1	us	10.000' \
  'gamma	1	us	10.000' \
  'latency	1	us	10.000' \
  'omega	1	us	10.000' \
  'theta	1	us	10.000' >"$graph_observation"

semantic=$(awk -F '\t' -v OFS='\t' '
  NR == 1 { print; next }
  { print $1, $2, $3 }
' "$flow" | perl -MDigest::SHA=sha256_hex -e \
  'local $/; print sha256_hex(<STDIN>)')

telemetry="$work/telemetry.tsv"
telemetry_semantic="$work/telemetry-semantic.tsv"
perl - "$telemetry" "$telemetry_semantic" "$manifest_digest" <<'PERL'
use strict;
use warnings;

my ($log_path, $semantic_path, $manifest) = @ARGV;
open my $log, '>', $log_path or die "cannot write $log_path: $!";
open my $semantic, '>', $semantic_path
    or die "cannot write $semantic_path: $!";
my @columns = qw(
    sample operation lifecycle pair level operation:order level:order
    time:wall:ns time:cpu:ns memory:allocations
    telemetry:detail:prepare:ns telemetry:detail:work:ns
    telemetry:detail:finish:ns result:code result:input:hash
    result:transcript:hash result:hash result:input:rows
    result:observation:rows result:host:events result:trace:records
    result:capture:records result:capture:hash storage:logical:bytes
    storage:encoded:bytes storage:retained:bytes storage:copied:bytes
    storage:cached:bytes storage:physical:bytes storage:allocated:bytes
    storage:reserved:bytes storage:growths storage:chunks storage:segments
    storage:cache:hits storage:cache:misses storage:cache:evictions
    capture:retained:bytes capture:retained:records capture:evicted:records
    capture:dropped:records public:input:rows public:input:bytes
    public:produced:rows public:choices public:evidence:rows
    public:evidence:bytes public:retained:bytes public:copied:bytes
    public:physical:bytes public:allocated:bytes public:reserved:bytes
    public:storage:growths public:result:hash event:source event:session
    event:scope event:code event:mode event:plan event:input:rows
    event:input:bytes event:produced:rows event:choices
    event:evidence:rows event:evidence:bytes event:retained:bytes
    event:copied:bytes event:physical:bytes event:allocated:bytes
    event:reserved:bytes event:storage:growths event:result:hash);
my @prefix = (
  "telemetry\t1",
  "identity\tmanifest\tsha256\t$manifest",
  "identity\tartifact\tsha256\t" . ('b' x 64),
  "config\tpairs\tcount\t60",
  "config\twarmups\tcount\t2",
  "config\toperations\tcount\t4",
  "design\toperations\torder\twilliams",
  "design\tlevels\torder\tpermutations",
  "columns\t" . join("\t", @columns),
);
print {$log} "$_\n" for @prefix;
print {$semantic} "$prefix[0]\n";
print {$semantic} "$_\n" for @prefix[3 .. $#prefix];

my @operations = qw(live record replay scenario);
my @lifecycles = qw(cold warm);
my @metrics = qw(wall cpu allocations copied prepare work finish);
my %unit = (wall => 'ns', cpu => 'ns', allocations => 'count',
            copied => 'bytes', prepare => 'ns', work => 'ns', finish => 'ns');
my @level_orders = (
  [qw(disabled basic detail)], [qw(disabled detail basic)],
  [qw(basic detail disabled)], [qw(detail basic disabled)],
  [qw(basic disabled detail)], [qw(detail disabled basic)],
);
my @operation_orders = (
  [qw(live record scenario replay)],
  [qw(record replay live scenario)],
  [qw(replay scenario record live)],
  [qw(scenario live replay record)],
);
my @operation_positions = qw(first second third last);
my @level_positions = qw(first middle last);
my %operation_id = (live => 1, record => 2, replay => 3, scenario => 4);
my %lifecycle_id = (cold => 1, warm => 2);

sub metric_value {
  my ($operation, $pair, $level, $metric) = @_;
  # One high wall-time sample exercises the fourth-highest p95 rank without
  # changing the expected p95 summary below.
  return $level eq 'disabled' ? 90
       : $level eq 'basic' ? 1000
       : 100 if $metric eq 'wall' && $pair == 60;
  my $odd = $pair % 2 == 1;
  return $level eq 'disabled' ? 90
       : $level eq 'basic' ? ($odd ? 100 : 110)
       : ($odd ? 110 : 100) if $metric eq 'wall';
  return $level eq 'disabled' ? 75
       : $level eq 'basic' ? ($odd ? 80 : 85)
       : ($odd ? 85 : 80) if $metric eq 'cpu';
  return $level eq 'disabled' ? 1
       : $level eq 'basic' ? ($odd ? 2 : 3)
       : ($odd ? 3 : 2) if $metric eq 'allocations';
  return $operation eq 'live' ? 0 : 32 if $metric eq 'copied';
  return $level eq 'detail' ? 3 : 0 if $metric eq 'prepare';
  return $level eq 'detail' ? 4 : 0 if $metric eq 'work';
  return $level eq 'detail' ? 2 : 0;
}

my $pairs = 60;
for my $lifecycle (@lifecycles) {
  for my $pair (1 .. $pairs) {
    my @pair_operations =
        @{$operation_orders[($pair - 1) % @operation_orders]};
    my @pair_levels = @{$level_orders[($pair - 1) % @level_orders]};
    for my $operation_position (0 .. 3) {
      my $operation = $pair_operations[$operation_position];
      my $persisted = $operation ne 'live';
      my $identity = 100 * $operation_id{$operation} +
          10 * $lifecycle_id{$lifecycle} + $pair;
      my $result = 3000 + $identity;
      my $growths = $persisted && $lifecycle eq 'cold' ? 1 : 0;
      for my $level_position (0 .. 2) {
        my $level = $pair_levels[$level_position];
        my $enabled = $level ne 'disabled';
        my $produced = $operation eq 'live' || $operation eq 'record' ? 1 : 0;
        my $choices = $operation eq 'scenario' ? 1 : 0;
        my $evidence_rows = $operation eq 'live' ? 0 : 1;
        my $evidence_bytes = $persisted ? 64 : 0;
        my $retained = $persisted ? 64 : 0;
        my $copied = $persisted ? 32 : 0;
        my $physical = $persisted ? 64 : 0;
        my $allocated = $persisted ? 4096 : 0;
        my $reserved = $persisted ? 96 : 0;
        my $plan = $operation eq 'live' ? 'none'
                 : ($operation eq 'record' || $lifecycle eq 'cold')
                     ? 'built' : 'reused';
        my @row = (
          'sample', $operation, $lifecycle, $pair, $level,
          $operation_positions[$operation_position],
          $level_positions[$level_position],
          metric_value($operation, $pair, $level, 'wall'),
          metric_value($operation, $pair, $level, 'cpu'),
          metric_value($operation, $pair, $level, 'allocations'),
          metric_value($operation, $pair, $level, 'prepare'),
          metric_value($operation, $pair, $level, 'work'),
          metric_value($operation, $pair, $level, 'finish'),
          0, 1000 + $identity, 2000 + $identity, $result,
          1, 0, 0, 0, 0, 0,
          $persisted ? 32 : 0, $persisted ? 64 : 0,
          $persisted ? 64 : 0, $persisted ? 32 : 0,
          $persisted ? 4096 : 0, $physical, $allocated, $reserved, $growths,
          $persisted ? 1 : 0, $persisted ? 1 : 0,
          $persisted && $lifecycle eq 'warm' ? 1 : 0,
          $persisted && $lifecycle eq 'cold' ? 1 : 0, 0,
          0, 0, 0, 0,
          1, 32, $produced, $choices, $evidence_rows, $evidence_bytes,
          $retained, $copied, $physical, $allocated, $reserved, $growths,
          $result,
          $enabled ? 'replay' : 'none', $enabled ? 42 : 0,
          $enabled ? $identity : 0, 0,
          $enabled ? $operation : 'none', $enabled ? $plan : 'none',
          $enabled ? 1 : 0, $enabled ? 32 : 0,
          $enabled ? $produced : 0, $enabled ? $choices : 0,
          $enabled ? $evidence_rows : 0, $enabled ? $evidence_bytes : 0,
          $enabled ? $retained : 0, $enabled ? $copied : 0,
          $enabled ? $physical : 0, $enabled ? $allocated : 0,
          $enabled ? $reserved : 0, $enabled ? $growths : 0,
          $enabled ? $result : 0,
        );
        @row == @columns or die "telemetry fixture sample width changed";
        print {$log} join("\t", @row), "\n";
        print {$semantic} join("\t", @row[0 .. 6], @row[13 .. $#row]), "\n";
      }
    }
  }
}

for my $operation (@operations) {
  for my $lifecycle (@lifecycles) {
    for my $metric (@metrics) {
      for my $pair (1 .. $pairs) {
        my $basic = metric_value($operation, $pair, 'basic', $metric);
        my $detail = metric_value($operation, $pair, 'detail', $metric);
        my ($direction, $magnitude) = $detail > $basic
            ? ('detail', $detail - $basic)
            : $basic > $detail ? ('basic', $basic - $detail) : ('equal', 0);
        my @row = ('delta', $operation, $lifecycle, $pair, $metric,
                   $direction, $magnitude);
        print {$log} join("\t", @row), "\n";
        print {$semantic} join("\t", @row[0 .. 4]), "\n";

        my $disabled = metric_value($operation, $pair, 'disabled', $metric);
        my ($reference_direction, $reference_magnitude) = $basic > $disabled
            ? ('basic', $basic - $disabled)
            : $disabled > $basic
                ? ('disabled', $disabled - $basic) : ('equal', 0);
        my @reference = ('reference', $operation, $lifecycle, $pair, $metric,
                         $reference_direction, $reference_magnitude);
        print {$log} join("\t", @reference), "\n";
        print {$semantic} join("\t", @reference[0 .. 4]), "\n";
      }

      my ($basic_median, $basic_p95) = $metric eq 'wall' ? ('105', '110')
          : $metric eq 'cpu' ? ('82.5', '85')
          : $metric eq 'allocations' ? ('2.5', '3')
          : $metric eq 'copied'
              ? (($operation eq 'live' ? 0 : 32),
                 ($operation eq 'live' ? 0 : 32))
          : (0, 0);
      my $phase = $metric eq 'prepare' ? 3
          : $metric eq 'work' ? 4 : $metric eq 'finish' ? 2 : 0;
      my $disabled = $metric eq 'wall' ? 90
          : $metric eq 'cpu' ? 75
          : $metric eq 'allocations' ? 1
          : $metric eq 'copied' && $operation ne 'live' ? 32 : 0;
      my $detail_median = $phase || $basic_median;
      my $detail_p95 = $phase || $basic_p95;
      my $delta_median = $phase;
      my $delta_p95 = $phase || ($metric eq 'wall' ? 10
          : $metric eq 'cpu' ? 5
          : $metric eq 'allocations' ? 1 : 0);
      my ($reference_median, $reference_p95) =
          $metric eq 'wall' ? (15, 20)
        : $metric eq 'cpu' ? (7.5, 10)
        : $metric eq 'allocations' ? (1.5, 2) : (0, 0);
      my @rows = (
        ['summary', $operation, $lifecycle, 'disabled', $metric, 'median',
         $unit{$metric}, 'absolute', $disabled],
        ['summary', $operation, $lifecycle, 'disabled', $metric, 'p95',
         $unit{$metric}, 'absolute', $disabled],
        ['summary', $operation, $lifecycle, 'basic', $metric, 'median',
         $unit{$metric}, 'absolute', $basic_median],
        ['summary', $operation, $lifecycle, 'basic', $metric, 'p95',
         $unit{$metric}, 'absolute', $basic_p95],
        ['summary', $operation, $lifecycle, 'detail', $metric, 'median',
         $unit{$metric}, 'absolute', $detail_median],
        ['summary', $operation, $lifecycle, 'detail', $metric, 'p95',
         $unit{$metric}, 'absolute', $detail_p95],
        ['summary', $operation, $lifecycle, 'delta', $metric, 'median',
         $unit{$metric}, $delta_median == 0 ? 'equal' : 'detail',
         $delta_median],
        ['summary', $operation, $lifecycle, 'delta', $metric, 'p95',
         $unit{$metric}, $delta_p95 == 0 ? 'equal' : 'detail', $delta_p95],
        ['summary', $operation, $lifecycle, 'reference', $metric, 'median',
